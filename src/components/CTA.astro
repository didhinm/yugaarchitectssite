---
import { contact } from '../data/site';

export interface Props {
  heading?: string;
}

const { heading = 'Planning a home, workplace or renovation?' } = Astro.props;
---

<section class="cta section section--stone" aria-labelledby="cta-heading">
  <div class="container grid">
    <div class="cta__inner reveal">
      <h2 id="cta-heading">{heading}</h2>
      <p class="muted cta__text">Tell us about your site, your brief and your timeline. We work across India and the UAE.</p>
      <div class="cta__actions">
        <a href="/contact/" class="button">Start a conversation</a>
        <a href={contact.whatsapp.href} class="button button--ghost">WhatsApp</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    margin-top: var(--section-gap);
  }

  .cta__inner {
    grid-column: 1 / -1;
  }

  .cta__text {
    margin-top: var(--space-2);
    max-width: var(--measure);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  @media (min-width: 64rem) {
    .cta__inner {
      grid-column: 1 / span 8;
    }
  }
</style>
