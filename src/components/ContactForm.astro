---
import { form, site, contact } from '../data/site';
import { absoluteUrl, url } from '../lib/url';
// With JS the form posts in the background and then opens the thanks page itself.
// Without JS it is a plain POST and Web3Forms redirects (same-domain only on the free plan).
---

<form
  class="form"
  action={form.endpoint}
  method="POST"
  novalidate
  data-contact-form
  data-thanks={url(form.redirectPath)}
  data-email={contact.email}
  data-whatsapp={contact.whatsapp.href}
>
  <input type="hidden" name="access_key" value={form.accessKey} />
  <input type="hidden" name="subject" value={form.subject} />
  <input type="hidden" name="from_name" value={site.name} />
  <input type="hidden" name="redirect" value={absoluteUrl(form.redirectPath)} />
  <!-- Honeypot: humans never see or fill this -->
  <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="form__grid">
    <div class="field">
      <label for="f-name" class="label">Name <span aria-hidden="true">*</span></label>
      <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="f-name-error" />
      <p class="field__error" id="f-name-error" data-error-for="f-name"></p>
    </div>

    <div class="field">
      <label for="f-email" class="label">Email <span aria-hidden="true">*</span></label>
      <input
        id="f-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        pattern="^[^\s@]+@[^\s@]+\.[^\s@]{2,}$"
        data-invalid="Please enter a valid email address, e.g. name@example.com."
        aria-describedby="f-email-error"
      />
      <p class="field__error" id="f-email-error" data-error-for="f-email"></p>
    </div>

    <div class="field">
      <label for="f-phone" class="label">Phone, with country code</label>
      <input
        id="f-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        pattern="^\+?[0-9 \(\)\-]{7,20}$"
        data-invalid="Please enter a valid phone number, including the country code."
        aria-describedby="f-phone-error"
      />
      <p class="field__error" id="f-phone-error" data-error-for="f-phone"></p>
    </div>

    <div class="field">
      <label for="f-location" class="label">Project location</label>
      <input id="f-location" name="project_location" type="text" placeholder="City, country" />
    </div>

    <div class="field">
      <label for="f-type" class="label">Project type</label>
      <select id="f-type" name="project_type" data-area-types={JSON.stringify(form.areaForTypes)}>
        <option value="">Select</option>
        {form.projectTypes.map((t) => <option>{t}</option>)}
      </select>
    </div>

    <div class="field" data-area-field>
      <label for="f-area" class="label">Approx. area (sq ft)</label>
      <input
        id="f-area"
        name="approx_area_sqft"
        type="text"
        inputmode="numeric"
        placeholder="e.g. 2,500"
        pattern="^[0-9][0-9, \.]{0,9}$"
        data-invalid="Please enter the area as a number, e.g. 2500."
        aria-describedby="f-area-error"
      />
      <p class="field__error" id="f-area-error" data-error-for="f-area"></p>
    </div>

    <div class="field">
      <label for="f-timeline" class="label">Approx. timeline</label>
      <select id="f-timeline" name="timeline">
        <option value="">Select</option>
        {form.timelines.map((t) => <option>{t}</option>)}
      </select>
    </div>

    <div class="field field--wide">
      <label for="f-message" class="label">Message <span aria-hidden="true">*</span></label>
      <textarea id="f-message" name="message" rows="6" required aria-describedby="f-message-error"></textarea>
      <p class="field__error" id="f-message-error" data-error-for="f-message"></p>
    </div>
  </div>

  <!-- hCaptcha is off in the Web3Forms dashboard, so the tick is required here in the browser as basic spam protection -->
  <div class="h-captcha" data-captcha="true"></div>
  <p class="field__error" id="f-captcha-error" data-captcha-error role="alert"></p>

  <p class="form__note muted">
    Fields marked * are required. Your details are used only to respond to your enquiry.
  </p>

  <button type="submit" class="button">Send enquiry</button>
  <p class="form__status" role="status" tabindex="-1" data-form-status></p>
</form>

<script is:inline src="https://web3forms.com/client/script.js" async defer></script>

<style>
  .form__grid {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 48rem) {
    .form__grid {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--gutter);
    }

    .field--wide {
      grid-column: 1 / -1;
    }
  }

  .field {
    display: grid;
    gap: var(--space-1);
  }

  .field[hidden] {
    display: none;
  }

  .field .label {
    color: var(--ink);
  }

  input:not([type='checkbox']):not([type='hidden']),
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0;
    border: 0;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    background: transparent;
    font-size: var(--size-body);
    transition: border-color var(--duration) var(--ease-out);
  }

  select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%),
      linear-gradient(135deg, var(--ink) 50%, transparent 50%);
    background-position: calc(100% - 10px) 55%, calc(100% - 5px) 55%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    padding-right: 1.5rem;
  }

  textarea {
    resize: vertical;
    border: 1px solid var(--rule);
    padding: 0.75rem;
  }

  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--muted);
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    border-color: var(--ink);
  }

  ::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  [aria-invalid='true'] {
    border-color: var(--ink) !important;
    border-bottom-width: 2px !important;
  }

  .field__error {
    min-height: 0;
    font-size: var(--size-small);
    color: var(--ink);
  }

  .field__error:empty {
    display: none;
  }

  .field__error::before {
    content: '— ';
  }

  .h-captcha {
    margin-top: var(--space-4);
  }

  .form__note {
    margin-block: var(--space-3);
    font-size: var(--size-small);
  }

  .form__status:empty {
    display: none;
  }

  .form__status {
    margin-top: var(--space-2);
  }
</style>

<script>
  const formEl = document.querySelector<HTMLFormElement>('[data-contact-form]');

  const messageFor = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const v = field.validity;
    if (v.valueMissing) return 'Please fill in this field.';
    if (v.typeMismatch || v.patternMismatch) return field.dataset.invalid || 'Please check this field.';
    return 'Please check this field.';
  };

  const validate = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const error = formEl?.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`);
    // Stray spaces around an email or number shouldn't make it invalid
    if (field.value !== field.value.trim()) field.value = field.value.trim();
    if (field.checkValidity()) {
      field.removeAttribute('aria-invalid');
      if (error) error.textContent = '';
      return true;
    }
    field.setAttribute('aria-invalid', 'true');
    if (error) error.textContent = messageFor(field);
    return false;
  };

  if (formEl) {
    const fields = Array.from(
      formEl.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[id], textarea[id]'),
    );

    fields.forEach((field) =>
      field.addEventListener('blur', () => {
        if (field.value || field.hasAttribute('aria-invalid')) validate(field);
      }),
    );

    // "Approx. area" only for some project types. Hidden + disabled otherwise, so it's neither validated nor sent.
    const typeSelect = formEl.querySelector<HTMLSelectElement>('#f-type');
    const areaField = formEl.querySelector<HTMLElement>('[data-area-field]');
    const areaInput = areaField?.querySelector<HTMLInputElement>('input');
    if (typeSelect && areaField && areaInput) {
      const areaTypes: string[] = JSON.parse(typeSelect.dataset.areaTypes || '[]');
      const syncArea = () => {
        const show = areaTypes.includes(typeSelect.value);
        areaField.hidden = !show;
        areaInput.disabled = !show;
        if (!show) {
          areaInput.removeAttribute('aria-invalid');
          const error = formEl.querySelector<HTMLElement>('[data-error-for="f-area"]');
          if (error) error.textContent = '';
        }
      };
      typeSelect.addEventListener('change', syncArea);
      syncArea();
    }

    const status = formEl.querySelector<HTMLElement>('[data-form-status]')!;
    const button = formEl.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const { thanks = '/contact/thanks/', email = '', whatsapp = '' } = formEl.dataset;

    const showError = (reason: string) => {
      status.textContent = '';
      const lead = document.createElement('span');
      lead.textContent = `Sorry, your enquiry couldn't be sent (${reason}). Please try again, or reach us by `;
      const mail = Object.assign(document.createElement('a'), { href: `mailto:${email}`, textContent: 'email' });
      const wa = Object.assign(document.createElement('a'), { href: whatsapp, textContent: 'WhatsApp' });
      status.append(lead, mail, ' or ', wa, '.');
      status.focus();
    };

    formEl.addEventListener('submit', async (event) => {
      event.preventDefault();
      const invalid = fields.filter((field) => !validate(field));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }

      // Basic spam protection: require the captcha tick before sending (checked here, not by Web3Forms)
      const captcha = formEl.querySelector<HTMLElement>('.h-captcha');
      const captchaError = formEl.querySelector<HTMLElement>('[data-captcha-error]');
      const captchaResponse = formEl.querySelector<HTMLTextAreaElement>('[name="h-captcha-response"]');
      if (captcha && !captchaResponse?.value) {
        if (captchaError) captchaError.textContent = 'Please tick the “I am human” box before sending.';
        captcha.scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }
      if (captchaError) captchaError.textContent = '';

      // Plain POST and redirect are the no-JS fallback; send JSON in the background instead.
      const data = Object.fromEntries(new FormData(formEl));
      delete data.redirect;

      status.textContent = 'Sending…';
      button.disabled = true;

      try {
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 20000);
        const response = await fetch(formEl.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
          signal: controller.signal,
        });
        window.clearTimeout(timeout);
        const result = await response.json().catch(() => ({}));

        if (response.ok && result.success) {
          window.location.assign(thanks);
          return;
        }
        showError(result.message || `error ${response.status}`);
      } catch (error) {
        showError(error instanceof DOMException && error.name === 'AbortError' ? 'the request timed out' : 'no connection');
      }
      button.disabled = false;
    });
  }
</script>
