---
import { Image } from 'astro:assets';
import { site, visibleNav, contact } from '../data/site';
import monogram from '../assets/brand/monogram.png';
import wordmark from '../assets/brand/wordmark.png';
import { url, stripBase } from '../lib/url';

const path = stripBase(Astro.url.pathname);
const isCurrent = (href: string) => path === href || path.startsWith(href);
const home = url('/');
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href={home} class="brand plain" aria-label={`${site.name}, ${site.subline}: home`}>
      <Image src={monogram} alt="" width={88} class="brand__mark" loading="eager" />
      <Image src={wordmark} alt="" width={320} class="brand__wordmark" loading="eager" />
    </a>

    <nav class="nav" aria-label="Main">
      <ul role="list" class="nav__list">
        {
          visibleNav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                class="nav__link label plain"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="menu-toggle label" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-open>
      Menu
    </button>
  </div>

  <div id="site-menu" class="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden data-menu>
    <div class="container menu__top">
      <a href={home} class="brand plain" aria-label={`${site.name}: home`}>
        <Image src={monogram} alt="" width={88} class="brand__mark" />
      </a>
      <button class="menu-toggle menu-toggle--close label" type="button" data-menu-close>Close</button>
    </div>
    <nav class="container menu__body" aria-label="Main">
      <ul role="list" class="menu__list">
        {
          visibleNav.map((item) => (
            <li>
              <a href={url(item.href)} class="menu__link plain" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul role="list" class="menu__contact">
        <li><a href={contact.whatsapp.href}>WhatsApp</a></li>
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><a href={contact.instagram.href}>Instagram</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration) var(--ease-out);
  }

  .site-header.is-compact {
    border-bottom-color: var(--rule);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    height: var(--header-height);
    transition: height var(--duration) var(--ease-out);
  }

  .is-compact .site-header__inner {
    height: var(--header-height-compact);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .brand__mark {
    height: var(--mark-height);
    width: auto;
    transition: height var(--duration) var(--ease-out);
  }

  .is-compact .brand__mark {
    height: calc(var(--mark-height) * 0.82);
  }

  /* The wordmark file carries empty space under the name line; nudge it down so the caps align with the monogram. */
  .brand__wordmark {
    display: none;
    height: calc(var(--mark-height) * 1.05);
    width: auto;
    margin-top: calc(var(--mark-height) * 0.22);
  }

  .is-compact .brand__wordmark {
    height: calc(var(--mark-height) * 0.86);
    margin-top: calc(var(--mark-height) * 0.18);
  }

  .nav {
    display: none;
  }

  .nav__list {
    display: flex;
    gap: var(--space-4);
  }

  .nav__link {
    color: var(--ink);
    padding-block: var(--space-1);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration) var(--ease-out);
  }

  .nav__link:hover,
  .nav__link[aria-current='page'] {
    border-bottom-color: var(--ink);
  }

  .menu-toggle {
    min-height: 2.75rem;
    padding: 0 0 0 var(--space-2);
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  @media (min-width: 64rem) {
    .brand__wordmark {
      display: block;
    }

    .nav {
      display: block;
    }

    .menu-toggle {
      display: none;
    }
  }

  /* Full-screen mobile menu */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    overflow-y: auto;
    animation: menu-in var(--duration) var(--ease-out);
  }

  .menu[hidden] {
    display: none;
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    flex-shrink: 0;
  }

  .menu__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-5) var(--space-4);
  }

  .menu__list li + li {
    margin-top: var(--space-2);
  }

  .menu__link {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(2.25rem, 8vw, 3.5rem);
    line-height: 1.15;
  }

  .menu__link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .menu__contact {
    display: grid;
    gap: var(--space-1);
    color: var(--muted);
    font-size: var(--size-small);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  // Compact header on scroll
  if (header) {
    let ticking = false;
    const update = () => {
      header.classList.toggle('is-compact', window.scrollY > 16);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }

  // Overlay menu with focus trap
  if (menu && openBtn && closeBtn) {
    const focusables = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    const onKey = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        close();
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    const open = () => {
      menu.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      document.addEventListener('keydown', onKey);
      closeBtn.focus();
    };

    function close() {
      if (!menu || !openBtn) return;
      menu.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      openBtn.focus();
    }

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    // Close if the viewport grows to desktop while open
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches && !menu.hidden) close();
    });
  }
</script>
