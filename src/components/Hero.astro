---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { heroWidths, heroSizes } from '../lib/hero';

export interface Props {
  src: ImageMetadata;
  alt: string;
  focus?: string;
}

const { src, alt, focus = '50% 50%' } = Astro.props;
---

<div class="hero">
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={heroWidths}
    sizes={heroSizes}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    style={`object-position: ${focus}`}
  />
</div>

<style>
  .hero {
    background: var(--stone);
  }

  .hero :global(img) {
    width: 100%;
    height: min(78svh, 133vw);
    min-height: 22rem;
    object-fit: cover;
  }

  @media (min-width: 64rem) {
    .hero :global(img) {
      height: min(88svh, 60vw);
    }
  }
</style>
