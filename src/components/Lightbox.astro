---
// Keyboard-accessible lightbox for [data-lightbox-item] links. Without JS the links open the image directly.
---

<dialog class="lightbox" aria-label="Image viewer" data-lightbox>
  <div class="lightbox__bar">
    <p class="label lightbox__count" aria-live="polite" data-lightbox-count></p>
    <button type="button" class="lightbox__btn label" data-lightbox-close>Close</button>
  </div>
  <figure class="lightbox__figure">
    <img alt="" data-lightbox-img />
  </figure>
  <div class="lightbox__nav">
    <button type="button" class="lightbox__btn label" data-lightbox-prev>Previous</button>
    <button type="button" class="lightbox__btn label" data-lightbox-next>Next</button>
  </div>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: var(--space-2) var(--margin);
    border: 0;
    background: var(--paper);
    color: var(--ink);
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-2);
    animation: fade var(--duration) var(--ease-out);
  }

  .lightbox::backdrop {
    background: var(--paper);
  }

  .lightbox__bar,
  .lightbox__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .lightbox__figure {
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__figure img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lightbox__btn {
    min-height: 2.75rem;
    padding: 0 var(--space-1);
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .lightbox__btn:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-lightbox-item]'));

  if (dialog && links.length && typeof dialog.showModal === 'function') {
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lightbox-count]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]')!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]')!;
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const link = links[current];
      img.src = link.href;
      img.alt = link.querySelector('img')?.alt ?? '';
      count.textContent = `${current + 1} / ${links.length}`;
    };

    links.forEach((link, i) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
        closeBtn.focus();
      });
    });

    prev.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    closeBtn.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });

    // Click on empty space closes
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      img.removeAttribute('src');
      opener?.focus();
    });
  }
</script>
