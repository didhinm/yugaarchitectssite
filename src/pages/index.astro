---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectTile from '../components/ProjectTile.astro';
import CTA from '../components/CTA.astro';
import { getPublishedProjects, type Project } from '../lib/projects';
import { heroPreload } from '../lib/hero';
import { site, services, founderPublished } from '../data/site';

const projects = await getPublishedProjects();
// Hero = the first project in `order` until the client picks one (brief §9, decision 3).
const heroProject = projects[0];
const preload = heroProject ? await heroPreload(heroProject.data.cover) : undefined;

// Alternate full-width and 2-up rows; a lone item at the end goes full width.
const rows: { size: 'full' | 'half'; items: Project[] }[] = [];
for (let i = 0; i < projects.length; ) {
  const wantFull = rows.length % 2 === 0;
  const remaining = projects.length - i;
  if (wantFull || remaining === 1) {
    rows.push({ size: 'full', items: [projects[i]] });
    i += 1;
  } else {
    rows.push({ size: 'half', items: projects.slice(i, i + 2) });
    i += 2;
  }
}
---

<BaseLayout preload={preload} image={heroProject?.data.cover} imageAlt={heroProject?.data.coverAlt}>
  <h1 class="visually-hidden">{site.name}: architecture and interiors studio, Palakkad, Kerala</h1>

  {
    heroProject && (
      <section aria-label="Featured project">
        <Hero src={heroProject.data.cover} alt={heroProject.data.coverAlt} focus={heroProject.data.coverFocus} />
        <div class="container hero-caption">
          <p class="hero-caption__tagline">{site.tagline}</p>
          <a href={`/projects/${heroProject.data.slug}/`} class="label hero-caption__project">
            {heroProject.data.title}
          </a>
        </div>
      </section>
    )
  }

  <section class="section intro" aria-label="About the studio">
    <div class="container grid">
      <p class="intro__text reveal">
        Yuga Architects is an architecture and interiors studio in Palakkad, Kerala, working on homes, workplaces
        and renovations across India and the UAE. <a href="/studio/">About the studio</a>
      </p>
    </div>
  </section>

  <section class="section work" aria-labelledby="work-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="work-heading" class="label">Selected work</h2>
        <a href="/projects/" class="label">All projects</a>
      </div>
      <div class="work__rows">
        {
          rows.map((row) => (
            <div class:list={['work__row', `work__row--${row.size}`]}>
              {row.items.map((project) => (
                <ProjectTile project={project} size={row.size} />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--stone services" aria-labelledby="services-heading">
    <div class="container grid">
      <div class="services__head">
        <h2 id="services-heading" class="label">Services</h2>
      </div>
      <ul role="list" class="services__list reveal">
        {services.map((s) => <li>{s.title}</li>)}
      </ul>
      <p class="services__more">
        <a href="/services/" class="label">Services and process</a>
      </p>
    </div>
  </section>

  {
    founderPublished && (
      <section class="section founder-teaser" aria-label="Founder">
        <div class="container">
          <a href="/founder/">Meet the founder</a>
        </div>
      </section>
    )
  }

  <CTA />
</BaseLayout>

<style>
  .hero-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-top: var(--space-2);
  }

  .hero-caption__tagline {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: var(--size-h3);
  }

  .hero-caption__project {
    text-decoration: none;
  }

  .hero-caption__project:hover {
    text-decoration: underline;
  }

  .intro__text {
    grid-column: 1 / -1;
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: var(--size-h2);
    line-height: 1.25;
    text-wrap: balance;
  }

  .intro__text a {
    display: block;
    width: fit-content;
    margin-top: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--size-body);
    font-weight: 400;
  }

  @media (min-width: 64rem) {
    .intro__text {
      grid-column: 1 / span 9;
    }
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }

  .section-head h2 {
    color: var(--ink);
  }

  .work__rows {
    display: grid;
    gap: var(--space-5);
  }

  .work__row--half {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .work__rows {
      gap: var(--space-6);
    }

    .work__row--half {
      grid-template-columns: 1fr 1fr;
      gap: var(--gutter);
    }
  }

  .services__head,
  .services__list,
  .services__more {
    grid-column: 1 / -1;
  }

  .services__head h2 {
    color: var(--ink);
  }

  .services__list {
    margin-top: var(--space-3);
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: var(--size-h2);
    line-height: 1.3;
  }

  .services__more {
    margin-top: var(--space-4);
  }

  @media (min-width: 64rem) {
    .services__head {
      grid-column: 1 / span 3;
    }

    .services__list {
      grid-column: 5 / span 8;
      margin-top: 0;
    }

    .services__more {
      grid-column: 5 / span 8;
    }
  }
</style>
