---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import ProjectTile from '../components/ProjectTile.astro';
import CTA from '../components/CTA.astro';
import { getPublishedProjects, type Project } from '../lib/projects';
import { heroPreload } from '../lib/hero';
import { Picture } from 'astro:assets';
import { site, services, founderPublished } from '../data/site';
import { founder, founderPortrait } from '../data/founder';
import { getHeroImages, toSlides, heroSettings, type HeroImage } from '../data/hero';

const projects = await getPublishedProjects();

// Hero slideshow from src/assets/hero/. Until images are added there, fall back to the first project's cover.
const heroImages: HeroImage[] = getHeroImages();
if (!heroImages.length && projects[0]) {
  const { cover, coverAlt, coverFocus } = projects[0].data;
  heroImages.push({ src: cover, alt: coverAlt, focus: coverFocus, focusMobile: coverFocus, file: projects[0].id, portrait: false });
}
const slides = toSlides(heroImages);
// Preload the first slide's image when it's a single full-width image (the LCP element).
const first = slides[0]?.images.length === 1 ? slides[0].images[0] : undefined;
const preload = first ? await heroPreload(first.src) : undefined;

// Alternate full-width and 2-up rows; a lone item at the end goes full width.
const rows: { size: 'full' | 'half'; items: Project[] }[] = [];
for (let i = 0; i < projects.length; ) {
  const wantFull = rows.length % 2 === 0;
  const remaining = projects.length - i;
  if (wantFull || remaining === 1) {
    rows.push({ size: 'full', items: [projects[i]] });
    i += 1;
  } else {
    rows.push({ size: 'half', items: projects.slice(i, i + 2) });
    i += 2;
  }
}
---

<BaseLayout preload={preload} image={heroImages[0]?.src} imageAlt={heroImages[0]?.alt}>
  <h1 class="visually-hidden">{site.name}: architecture and interiors studio, Palakkad, Kerala</h1>

  {
    slides.length > 0 && (
      <HeroSlideshow slides={slides} intervalSeconds={heroSettings.intervalSeconds} fadeMs={heroSettings.fadeMs}>
        <p class="hero-tagline">{site.tagline}</p>
      </HeroSlideshow>
    )
  }

  <section class="section intro" aria-label="About the studio">
    <div class="container grid">
      <p class="intro__text reveal">
        Yuga Architects is an architecture and interiors studio in Palakkad, Kerala, working on homes, workplaces
        and renovations across India and the UAE. <a href={url('/studio/')}>About the studio</a>
      </p>
    </div>
  </section>

  <section class="section work" aria-labelledby="work-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="work-heading" class="label">Selected work</h2>
        <a href={url('/projects/')} class="label">All projects</a>
      </div>
      <div class="work__rows">
        {
          rows.map((row) => (
            <div class:list={['work__row', `work__row--${row.size}`]}>
              {row.items.map((project) => (
                <ProjectTile project={project} size={row.size} />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--stone services" aria-labelledby="services-heading">
    <div class="container grid">
      <div class="services__head">
        <h2 id="services-heading" class="label">Services</h2>
      </div>
      <ul role="list" class="services__list reveal">
        {services.map((s) => <li>{s.title}</li>)}
      </ul>
      <p class="services__more">
        <a href={url('/services/')} class="label">Services and process</a>
      </p>
    </div>
  </section>

  {
    founderPublished && (
      <section class="section founder-teaser" aria-labelledby="founder-heading">
        <div class="container grid">
          <h2 id="founder-heading" class="label founder-teaser__label">
            Founder
          </h2>
          {founderPortrait && (
            <div class="founder-teaser__portrait reveal">
              <Picture
                src={founderPortrait}
                alt={`Portrait of ${founder.name}`}
                formats={['avif', 'webp']}
                widths={[320, 480, 640]}
                sizes="(min-width: 64rem) 20vw, 50vw"
                loading="lazy"
              />
            </div>
          )}
          <div class="founder-teaser__text reveal">
            <p class="founder-teaser__name">{founder.name}</p>
            <p class="muted">{founder.role}</p>
            <p class="founder-teaser__summary">{founder.summary}</p>
            <p>
              <a href={url('/founder/')} class="label">
                About the founder
              </a>
            </p>
          </div>
        </div>
      </section>
    )
  }

  <CTA />
</BaseLayout>

<style>
  .hero-tagline {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: var(--size-h3);
  }

  .intro__text {
    grid-column: 1 / -1;
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: var(--size-h2);
    line-height: 1.25;
    text-wrap: balance;
  }

  .intro__text a {
    display: block;
    width: fit-content;
    margin-top: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--size-body);
    font-weight: 400;
  }

  @media (min-width: 64rem) {
    .intro__text {
      grid-column: 1 / span 9;
    }
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }

  .section-head h2 {
    color: var(--ink);
  }

  .work__rows {
    display: grid;
    gap: var(--space-5);
  }

  .work__row--half {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .work__rows {
      gap: var(--space-6);
    }

    .work__row--half {
      grid-template-columns: 1fr 1fr;
      gap: var(--gutter);
    }
  }

  .services__head,
  .services__list,
  .services__more {
    grid-column: 1 / -1;
  }

  .services__head h2 {
    color: var(--ink);
  }

  .services__list {
    margin-top: var(--space-3);
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: var(--size-h2);
    line-height: 1.3;
  }

  .services__more {
    margin-top: var(--space-4);
  }

  @media (min-width: 64rem) {
    .services__head {
      grid-column: 1 / span 3;
    }

    .services__list {
      grid-column: 5 / span 8;
      margin-top: 0;
    }

    .services__more {
      grid-column: 5 / span 8;
    }
  }

  .founder-teaser__label {
    grid-column: 1 / -1;
    color: var(--ink);
    margin-bottom: var(--space-3);
  }

  .founder-teaser__portrait {
    grid-column: 1 / span 2;
    margin-bottom: var(--space-3);
    background: var(--stone);
  }

  .founder-teaser__portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .founder-teaser__text {
    grid-column: 1 / -1;
  }

  .founder-teaser__text > * + * {
    margin-top: var(--space-1);
  }

  .founder-teaser__name {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: var(--size-h2);
    line-height: 1.2;
  }

  .founder-teaser__summary {
    max-width: var(--measure);
    margin-top: var(--space-3) !important;
  }

  .founder-teaser__text > p:last-child {
    margin-top: var(--space-4);
  }

  @media (min-width: 64rem) {
    .founder-teaser__label {
      grid-column: 1 / span 3;
      margin-bottom: 0;
    }

    .founder-teaser__portrait {
      grid-column: 5 / span 2;
      margin-bottom: 0;
    }

    .founder-teaser__text {
      grid-column: 5 / span 8;
    }

    .founder-teaser__portrait + .founder-teaser__text {
      grid-column: 7 / span 6;
    }
  }
</style>
