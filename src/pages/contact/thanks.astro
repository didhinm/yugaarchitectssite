---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';
import { contact } from '../../data/site';
---

<BaseLayout title="Thank you" description="Your enquiry has been sent to Yuga Architects." noindex>
  <header class="container page-head thanks">
    <p class="label">Enquiry sent</p>
    <h1>Thank you</h1>
    <p class="lead">
      We have your message and will reply soon. If it is urgent, message us on
      <a href={contact.whatsapp.href}>WhatsApp</a>.
    </p>
    <p><a href={url('/projects/')} class="button button--ghost">Back to projects</a></p>
  </header>

  <!-- Counts a completed enquiry in Google Analytics (no-op when analytics is off) -->
  <script is:inline>
    if (typeof window.gtag === 'function') window.gtag('event', 'generate_lead', { form: 'contact' });
  </script>
</BaseLayout>

<style>
  .thanks {
    padding-bottom: var(--section-gap);
  }
</style>
