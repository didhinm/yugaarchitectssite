---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import Icon from '../../components/Icon.astro';
import { contact, address, hours } from '../../data/site';

const direct = [
  { icon: 'mail', label: 'Email', href: `mailto:${contact.email}`, text: contact.email },
  { icon: 'whatsapp', label: 'WhatsApp', href: contact.whatsapp.href, text: contact.whatsapp.display },
  { icon: 'phone', label: 'Call India', href: contact.phoneIndia.href, text: contact.phoneIndia.display },
  { icon: 'phone', label: 'Call UAE', href: contact.phoneUae.href, text: contact.phoneUae.display },
  { icon: 'instagram', label: 'Instagram', href: contact.instagram.href, text: contact.instagram.handle },
] as const;
---

<BaseLayout
  title="Contact"
  description="Start a conversation with Yuga Architects about your home, workplace or renovation in Kerala, India or the UAE. Email, WhatsApp or call."
>
  <header class="container page-head">
    <p class="label">Contact</p>
    <h1>Start a conversation</h1>
    <p class="lead">
      Tell us a little about your project and we will get back to you. {contact.visits}
    </p>
  </header>

  <div class="container grid contact">
    <section class="contact__form" aria-labelledby="form-heading">
      <h2 id="form-heading" class="label contact__heading">Enquiry</h2>
      <ContactForm />
    </section>

    <aside class="contact__direct" aria-label="Direct contact">
      <div class="block">
        <h2 class="label contact__heading">Direct</h2>
        <ul role="list" class="direct">
          {
            direct.map((item) => (
              <li>
                <a href={item.href} class="direct__link plain">
                  <Icon name={item.icon} size={22} class="direct__icon" />
                  <span class="label direct__label">{item.label}</span>
                  <span class="direct__text">{item.text}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="block">
        <h2 class="label contact__heading">Studio</h2>
        <address>
          {address.street}<br />
          {address.locality}, {address.region} {address.postalCode}<br />
          {address.country}
        </address>
        <p><a href={address.mapsHref}>Get directions</a></p>
      </div>

      <div class="block">
        <h2 class="label contact__heading">Hours</h2>
        <p>{hours.display}</p>
        <p class="muted">{contact.visits}</p>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .contact {
    row-gap: var(--space-6);
    padding-bottom: var(--section-gap);
  }

  .contact__form,
  .contact__direct {
    grid-column: 1 / -1;
  }

  .contact__heading {
    color: var(--ink);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }

  .block + .block {
    margin-top: var(--space-5);
  }

  .block > p {
    margin-top: var(--space-1);
  }

  address {
    font-style: normal;
  }

  .direct li + li {
    margin-top: var(--space-1);
  }

  /* Icon on the left, spanning the label and value lines */
  .direct__link {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-2);
    align-items: center;
    padding-block: var(--space-1);
    color: var(--ink);
  }

  .direct__link :global(.direct__icon) {
    grid-row: 1 / span 2;
    justify-self: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.5625rem;
    border: 1px solid var(--rule);
    border-radius: 50%;
    color: var(--ink);
    transition: background-color var(--duration) var(--ease-out), color var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out);
  }

  .direct__label {
    align-self: end;
  }

  .direct__text {
    align-self: start;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-underline-offset var(--duration) var(--ease-out);
  }

  .direct__link:hover .direct__text {
    text-underline-offset: 0.35em;
  }

  .direct__link:hover :global(.direct__icon) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  @media (min-width: 64rem) {
    .contact__form {
      grid-column: 1 / span 7;
    }

    .contact__direct {
      grid-column: 9 / span 4;
    }
  }
</style>
