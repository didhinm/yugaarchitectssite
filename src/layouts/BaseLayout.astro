---
import type { ImageMetadata } from 'astro';
import '@fontsource-variable/jost';
import '@fontsource-variable/instrument-sans';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Holding from '../components/Holding.astro';
import Analytics from '../components/Analytics.astro';
import { url } from '../lib/url';
import { HOLDING_PAGE } from '../../site-mode.mjs';

export interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  /** Responsive AVIF source of the above-the-fold hero, to preload. */
  preload?: { srcset: string; sizes: string };
}

const { preload, ...pageSeo } = Astro.props;

// While the holding page is on, every URL renders it instead of the page content.
const seo = HOLDING_PAGE
  ? {
      title: 'Unearthing soon',
      description: 'The Yuga Architects website is coming soon. Architecture and interiors from Palakkad, Kerala, across India and the UAE.',
      noindex: true,
    }
  : pageSeo;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={HOLDING_PAGE ? '#141414' : '#FFFFFF'} />
    <Seo {...seo} />
    <Analytics />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/brand/icon-32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('/brand/icon-180.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    {!HOLDING_PAGE && <link rel="sitemap" href={url('/sitemap-index.xml')} />}
    {
      !HOLDING_PAGE && preload && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          imagesrcset={preload.srcset}
          imagesizes={preload.sizes}
          fetchpriority="high"
        />
      )
    }
    {
      !HOLDING_PAGE && (
        <script is:inline>
          if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('js-reveal');
          }
        </script>
      )
    }
  </head>
  <body class:list={[{ 'is-holding': HOLDING_PAGE }]}>
    {
      HOLDING_PAGE ? (
        <Holding />
      ) : (
        <>
          <a href="#main" class="skip-link">Skip to content</a>
          <Header />
          <main id="main" tabindex="-1">
            <slot />
          </main>
          <Footer />
          <script>
            if (document.documentElement.classList.contains('js-reveal')) {
              const observer = new IntersectionObserver(
                (entries) => {
                  for (const entry of entries) {
                    if (entry.isIntersecting) {
                      entry.target.classList.add('is-visible');
                      observer.unobserve(entry.target);
                    }
                  }
                },
                { rootMargin: '0px 0px -8% 0px' },
              );
              document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
            }
          </script>
        </>
      )
    }
  </body>
</html>
